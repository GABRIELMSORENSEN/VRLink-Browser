{
  "name": "vrlink-browser",
  "version": "1.1.0",
  "description": "Navegador privado com envio de mídia direta para players de vídeo do VRChat.",
  "main": "src/main.js",
  "author": "GABRIELMSORENSEN",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win zip"
  },
  "build": {
    "appId": "com.g4t0xx.vrlink",
    "productName": "VRLink Browser",
    "artifactName": "VRLink-Browser-${version}-Windows.${ext}",
    "files": ["src/**/*", "README.md", "LICENSE"],
    "win": { "target": ["zip"] }
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  }
}
